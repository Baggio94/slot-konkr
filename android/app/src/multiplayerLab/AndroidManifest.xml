<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Dedicated, intentionally non-HOME app for real KONKR Multiplayer QA.
         The original fyi.slot.konkr launcher/home/default selection stays untouched. -->
    <application android:label="slot. Multiplayer Lab" tools:replace="android:label">
        <activity
            android:name="fyi.slot.konkr.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="landscape"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
